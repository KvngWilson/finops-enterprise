    {
      "name": "Register corporate client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clients",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"companyName\": \"Postman Demo Corporation\",\n  \"registrationNumber\": \"{{uniqueRegistration}}\",\n  \"industry\": \"Technology\",\n  \"country\": \"Canada\",\n  \"contactEmail\": \"operations@example.com\",\n  \"contactPhone\": \"+1 555 010 9999\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('createdClientId', pm.response.json().data.clientId);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('uniqueRegistration', 'PM-' + Date.now());"
            ]
          }
        }
      ]
    },

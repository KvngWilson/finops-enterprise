{
  "info": {
    "name": "FinOps Enterprise Release 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against demonstration data. Client/account creation persists; each run generates a new registration number. All requests assert expected HTTP status."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "missingId",
      "value": "00000000-0000-4000-8000-999999999999"
    },
    {
      "key": "createdClientId",
      "value": ""
    },
    {
      "key": "createdAccountId",
      "value": ""
    },
    {
      "key": "uniqueRegistration",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
